# LINE Channel Configuration (for Cloud Functions)
# Get these from LINE Developers Console: https://developers.line.biz/
LINE_CHANNEL_ID=your-channel-id
LINE_CHANNEL_SECRET=your-channel-secret
# Optional: LINE Login redirect_uri for the home-screen app hand-off. Defaults to
# https://<region>-<project>.cloudfunctions.net/lineLoginCallback — must match
# the Callback URL registered in the LINE Login channel.
# LINE_LOGIN_CALLBACK_URL=
