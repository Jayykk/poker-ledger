# Firebase Configuration
# These values are safe to expose in client-side code as they identify the Firebase project
# Actual security is controlled by Firestore security rules

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# LINE LIFF Configuration
# Create a LIFF app in LINE Developers Console (https://developers.line.biz/)
# Channel type: LINE Login → LIFF tab → Add LIFF app
# Size: Full; Endpoint URL: your deployed app URL (e.g. https://your-project.web.app)
VITE_LIFF_ID=your-liff-id

# Firebase AI Logic (Gemini) — photo → card recognition in the hand-record form
# Enable in Firebase Console → Build → AI Logic (Gemini Developer API). Defaults to gemini-3.7-flash.
VITE_GEMINI_MODEL=gemini-3.7-flash
# App Check is enforced for Firebase AI Logic. reCAPTCHA Enterprise site key
# (Google Cloud → Security → reCAPTCHA Enterprise → Website key; add your GitHub Pages domain + localhost)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-enterprise-site-key
# Local dev only: "true" prints a debug token in the browser console on first use — register it in
# Firebase Console → App Check → Apps → Manage debug tokens. Or paste an already-registered token here.
VITE_APPCHECK_DEBUG_TOKEN=
