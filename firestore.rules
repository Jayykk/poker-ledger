rules_version = '2';

// ============================================================================
// Access model ("capability" / link-based):
// Document IDs are unguessable Firestore auto-IDs. Possessing an ID (via a
// share link) grants access to that document — this is intentional and what
// makes link-based joining work (LINE deep links, dealer clock URLs, etc.).
//
// What we DO restrict is `list` (collection queries): without these limits any
// signed-in user could enumerate every game / settlement in the database with
// an unfiltered query. `get` (single doc by ID) stays open to keep link-based
// flows working.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Admin status = document existence in the 'admins' collection.
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // True when `after` differs from `before` (both string lists) at most by
    // adding and/or removing the single uid — used to pin RSVP writes to the
    // caller's own membership.
    function onlySelfDelta(before, after, uid) {
      return (after.toSet().difference(before.toSet()).size() == 0 ||
              after.toSet().difference(before.toSet()) == [uid].toSet()) &&
             (before.toSet().difference(after.toSet()).size() == 0 ||
              before.toSet().difference(after.toSet()) == [uid].toSet());
    }

    // ============================================
    // Users
    // ============================================
    match /users/{userId} {
      // Friend search and the leaderboard list all user profiles.
      allow get, list: if isAuthenticated();
      allow write: if isOwner(userId);

      // Per-game history projection, written by Cloud Functions only.
      // Read is open to any signed-in user because the leaderboard aggregates
      // every player's per-game results (matches the open users get/list above).
      match /history_sub/{gameId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /friends/{friendId} {
        allow read: if isOwner(userId);
        // Accepting a friend request mirrors an entry into the *requester's*
        // friends list, so the accepter must be able to create a doc that
        // references themselves.
        allow create: if isOwner(userId) ||
          (isAuthenticated() && request.resource.data.uid == request.auth.uid);
        allow update, delete: if isOwner(userId);
      }

      // Game invitations are written into the invitee's mailbox by the inviter.
      match /invitations/{invitationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }

      match /tournamentPresets/{presetId} {
        allow read, write: if isOwner(userId);
      }

      match /cashPresets/{presetId} {
        allow read, write: if isOwner(userId);
      }

      // Table templates (開桌範本) and the blind-structure library that
      // replace the two preset collections above (utils/tableTemplates.js)
      match /tableTemplates/{templateId} {
        allow read, write: if isOwner(userId);
      }

      match /blindStructures/{structureId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // Admin registry — managed server-side only.
    // ============================================
    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ============================================
    // Leaderboard aggregates — one doc per user per period, recomputed by
    // Cloud Functions after each history projection (never client-written).
    // Read is open to signed-in users: same visibility as history_sub above.
    // ============================================
    match /leaderboardStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // 稱號 (titles) — one doc per user, computed by Cloud Functions from the
    // all-time stats; prefs change through the setTitlePrefs callable only
    // (users/{uid} is owner-writable, so titles can't live there).
    // ============================================
    match /userTitles/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // Friend requests (mailbox)
    // ============================================
    match /friendRequests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.fromUid == request.auth.uid;
      // Recipients read their own requests (query must filter toUid).
      allow read: if isAuthenticated() && resource.data.toUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ============================================
    // Ledger games (cash / tournament bookkeeping)
    // ============================================
    match /games/{gameId} {
      // Single-doc reads stay open: link-based joining must read the game
      // before the user becomes a participant.
      allow get: if isAuthenticated();
      // Queries: the lobby lists active games; table management lists own
      // games; admins list everything. Settled games (with full financial
      // history) cannot be enumerated by strangers.
      allow list: if isAuthenticated() &&
        (resource.data.status == 'active' ||
         resource.data.hostUid == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.hostUid == request.auth.uid;
      // Joining via link adds yourself to the players array, and seated
      // players update stacks/buy-ins — both happen before/without being the
      // host, so updates follow the capability model (having the ID = invited).
      // Non-hosts are limited to the roster (players/updatedAt, plus the
      // roster revision counter `rev` every roster write bumps): settlement,
      // lifecycle, and ownership fields (settlementSnapshot, status, rate,
      // hostUid, …) are host/admin-only. A settled game's roster is frozen for
      // non-hosts: a players change there re-runs the history projection, so
      // it would rewrite everyone's stats and the leaderboard.
      allow update: if isAuthenticated() &&
        (resource.data.hostUid == request.auth.uid ||
         isAdmin() ||
         (resource.data.status != 'completed' &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['players', 'updatedAt', 'rev'])));
      allow delete: if isAuthenticated() &&
        (resource.data.hostUid == request.auth.uid || isAdmin());

      // Config version history (written by frontend after each config change)
      match /configVersions/{versionId} {
        allow read: if isAuthenticated() &&
          (resource == null ||
           request.auth.uid == get(/databases/$(database)/documents/games/$(gameId)).data.hostUid ||
           isAdmin());
        allow create: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/games/$(gameId)).data.hostUid ||
           isAdmin());
        allow update, delete: if false;
      }

      // Game chat
      match /chat/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }

      // Manual hand records (created/managed from the frontend).
      //  - While the game is not completed (in the room): any signed-in user,
      //    as before.
      //  - Once completed: the host / an admin (CashTableEditView), or 補記手牌
      //    (src/utils/handBackfill.js, keep in step): a player of the game
      //    within 7 days of its end, the hand signed as theirs
      //    (recordedBy + recordedAfter). Rules can't search the roster (a list
      //    of maps), so the hand names the recorder's roster slot
      //    (recorderIndex) and that one slot must hold their uid.
      //  - A hand recorded afterwards is changed / removed only by whoever
      //    recorded it, the host, or an admin, and stays signed as theirs.
      match /hands/{handId} {
        function parentGame() {
          return get(/databases/$(database)/documents/games/$(gameId)).data;
        }

        function isGameHost(game) {
          return game.get('hostUid', null) == request.auth.uid;
        }

        // A stored time (Timestamp or millis) less than 7 days ago
        function withinBackfillWindow(time) {
          return (time is timestamp && request.time < time + duration.value(7, 'd')) ||
            (time is number && request.time.toMillis() < time + 604800000);
        }

        // The game's end: completedAt, else updatedAt, else createdAt
        function backfillOpen(game) {
          return game.get('completedAt', null) != null
            ? withinBackfillWindow(game.completedAt)
            : (game.get('updatedAt', null) != null
              ? withinBackfillWindow(game.updatedAt)
              : withinBackfillWindow(game.get('createdAt', null)));
        }

        function isRosterSlotOfCaller(game, index) {
          return index is int && index >= 0 &&
            game.get('players', []) is list && index < game.get('players', []).size() &&
            game.players[index] is map &&
            game.players[index].get('uid', null) == request.auth.uid;
        }

        function isBackfillByParticipant(game) {
          let data = request.resource.data;
          return data.get('recordedBy', null) == request.auth.uid &&
            data.get('recordedAfter', false) == true &&
            isRosterSlotOfCaller(game, data.get('recorderIndex', -1)) &&
            backfillOpen(game);
        }

        allow read: if isAuthenticated();

        // Nobody signs a hand as someone else
        allow create: if isAuthenticated() &&
          request.resource.data.get('recordedBy', request.auth.uid) == request.auth.uid && (
          parentGame().get('status', null) != 'completed' ||
          isGameHost(parentGame()) ||
          isAdmin() ||
          isBackfillByParticipant(parentGame())
        );

        allow update: if isAuthenticated() && (
          resource.data.get('recordedAfter', false) != true ||
          ((resource.data.get('recordedBy', null) == request.auth.uid ||
            isGameHost(parentGame()) ||
            isAdmin()) &&
           !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['recordedBy', 'recordedAfter', 'recorderIndex']))
        );

        allow delete: if isAuthenticated() && (
          resource.data.get('recordedAfter', false) != true ||
          resource.data.get('recordedBy', null) == request.auth.uid ||
          isGameHost(parentGame()) ||
          isAdmin()
        );
      }
    }

    // Collection-group reads for hand records: the leaderboard's special-hands
    // statistics query `collectionGroup('hands')` across games and pokerGames.
    match /{path=**}/hands/{handId} {
      allow read: if isAuthenticated();
    }

    // ============================================
    // Texas Hold'em poker rooms (Cloud Functions managed)
    // ============================================
    match /pokerGames/{gameId} {
      // Single-doc reads stay open for link-based joining and spectators.
      allow get: if isAuthenticated();
      // Queries: lobby lists joinable rooms; table management lists own rooms;
      // admins list everything. Finished games cannot be enumerated.
      allow list: if isAuthenticated() &&
        (resource.data.status in ['waiting', 'playing'] ||
         resource.data.meta.createdBy == request.auth.uid ||
         isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.meta.createdBy == request.auth.uid;

      // Update rules:
      //  - The room creator (meta.createdBy) or an admin can update any fields,
      //    including the managed config fields inside `meta`.
      //  - Everyone else may only flip the `settling` flag (client auto-settle
      //    in store/modules/poker.js). Seats, chips, pot and turn state are
      //    Cloud Functions-only.
      allow update: if isAuthenticated() &&
        (resource.data.meta.createdBy == request.auth.uid ||
         isAdmin() ||
         request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['settling']));

      allow delete: if isAuthenticated() &&
        (resource.data.meta.createdBy == request.auth.uid || isAdmin());

      // Config version history for cash table admin edits.
      match /configVersions/{versionId} {
        allow read: if isAuthenticated() &&
          (resource == null ||
           request.auth.uid == get(/databases/$(database)/documents/pokerGames/$(gameId)).data.meta.createdBy ||
           isAdmin());
        allow create: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/pokerGames/$(gameId)).data.meta.createdBy ||
           isAdmin());
        allow update, delete: if false;
      }

      // Hand history — written by Cloud Functions only.
      match /hands/{handId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      // Game event log (actions, shown cards, …) — Cloud Functions only.
      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      // Private hole cards — only the player can read; only Cloud Functions
      // write. This is the anti-cheat boundary.
      match /private/{userId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ============================================
    // Transaction audit trail (buy-in records)
    // ============================================
    // NOTE: reads stay open (capability model — the log is queried by gameId,
    // and rules cannot require "some equality filter on gameId" for queries).
    // The real fix is moving these under games/{gameId}/transactions so the
    // parent doc gates access; tracked in TODO.md (P0, mid-term).
    match /transactions/{txId} {
      allow read: if isAuthenticated();
      // The writer must sign the record as themselves (actionUid) with a sane
      // shape — matches the client fallback writer in useTransactions.js.
      // (The Cloud Function path uses the Admin SDK and bypasses rules.)
      allow create: if isAuthenticated()
        && request.resource.data.actionUid == request.auth.uid
        && request.resource.data.gameId is string
        && request.resource.data.amount is number
        && request.resource.data.type is string
        && request.resource.data.status == 'active';
      // Only allow flipping an active record to undone (nothing else may
      // change), and only by whoever recorded it, the game's host, or an
      // admin — mirrors the UI's canUndo() gate (TransactionLog.vue).
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        && request.resource.data.status == 'undone'
        && resource.data.status == 'active'
        && (resource.data.actionUid == request.auth.uid
            || isAdmin()
            || get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.hostUid == request.auth.uid);
    }

    // ============================================
    // Tournament sessions (clock state)
    // ============================================
    match /tournamentSessions/{sessionId} {
      // Dealer clock / time bank views are opened from shared URLs (often with
      // anonymous auth), so single-doc reads stay open.
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() &&
        (resource.data.hostUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.hostUid == request.auth.uid;
      // Host can always update; admins can update any session. With dealer
      // mode on, anyone (dealer clocks are often anonymous) may drive the
      // clock — `state` and the face style — but never config, ownership or
      // the dealer-mode switch itself.
      allow update: if isAuthenticated()
        && (resource.data.hostUid == request.auth.uid
            || isAdmin()
            || (resource.data.dealerModeEnabled == true
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['state', 'updatedAt', 'clockStyle'])));
      allow delete: if isAuthenticated()
        && (resource.data.hostUid == request.auth.uid || isAdmin());

      // Config version history
      match /configVersions/{versionId} {
        allow read: if isAuthenticated() &&
          (resource == null ||
           request.auth.uid == get(/databases/$(database)/documents/tournamentSessions/$(sessionId)).data.hostUid ||
           isAdmin());
        allow create: if isAuthenticated() &&
          (request.auth.uid == get(/databases/$(database)/documents/tournamentSessions/$(sessionId)).data.hostUid ||
           isAdmin());
        allow update, delete: if false;
      }
    }

    // ============================================
    // Live events (Session layer): RSVP + ordered table queue above live tables
    // ============================================
    match /sessions/{sessionId} {
      // Shared via the same LIFF link — single-doc reads stay open so visitors
      // can see the scheduling page / be routed to the active table.
      allow get: if isAuthenticated();
      // Hosts list their own events; registered players list events they joined
      // (query: participantUids array-contains uid); admins list everything.
      allow list: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        request.auth.uid in resource.data.participantUids ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.hostUid == request.auth.uid;
      // Host/admin may change anything. Any other authenticated user may update
      // ONLY the per-period rosters (RSVP join/cancel) via `periods` +
      // `participantUids` — not status, name, etc. RSVP writes additionally may
      // not add/remove periods, and may only add/remove the caller themselves
      // from the participant roster. (Per-entry roster contents inside
      // `periods` can't be validated in rules — full enforcement needs a CF.)
      allow update: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['periods', 'participantUids', 'updatedAt'])
         && request.resource.data.periods.size() == resource.data.periods.size()
         && onlySelfDelta(resource.data.participantUids,
                          request.resource.data.participantUids,
                          request.auth.uid))
      );
      allow delete: if isAuthenticated() &&
        (resource.data.hostUid == request.auth.uid || isAdmin());

      // Expenses (代墊分帳): orders someone paid for and how the event's
      // players pay them back. Players of the event (any period) and the host
      // read them and record their own; the payer, whoever recorded it, and
      // the host edit or delete one. Only the host may record or move an
      // expense on someone else's behalf.
      match /expenses/{expenseId} {
        function event() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
        }
        function isEventHost() {
          return event().hostUid == request.auth.uid;
        }
        function isEventMember() {
          return isEventHost() || request.auth.uid in event().participantUids;
        }
        function validExpense(d) {
          return d.payerUid is string && d.lines is list && d.lines.size() <= 200 &&
            d.names is map && d.title is string && d.title.size() <= 100;
        }

        allow read: if isAuthenticated() && (isEventMember() || isAdmin());
        allow create: if isAuthenticated() && isEventMember() &&
          validExpense(request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid &&
          (request.resource.data.payerUid == request.auth.uid || isEventHost());
        allow update: if isAuthenticated() && validExpense(request.resource.data) &&
          request.resource.data.createdBy == resource.data.createdBy && (
            isEventHost() || isAdmin() ||
            ((resource.data.payerUid == request.auth.uid || resource.data.createdBy == request.auth.uid) &&
             request.resource.data.payerUid == resource.data.payerUid)
          );
        allow delete: if isAuthenticated() && (
          resource.data.payerUid == request.auth.uid ||
          resource.data.createdBy == request.auth.uid ||
          isEventHost() || isAdmin()
        );
      }
    }

    // ============================================
    // Time bank sessions
    // ============================================
    match /timeBankSessions/{sessionId} {
      // Shared via URL — single-doc reads stay open.
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() &&
        (resource.data.hostUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.hostUid == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.hostUid == request.auth.uid;
    }

    // ============================================
    // LINE Login hand-off (home-screen app)
    // ============================================
    // Parked authorization codes — only the Cloud Functions (Admin SDK)
    // touch these; clients must never read them.
    match /lineLoginHandoffs/{state} {
      allow read, write: if false;
    }

    // Error reports (reportClientError) — backend only
    match /clientErrors/{id} {
      allow read, write: if false;
    }
  }
}
